    {
      "type": "text",
      "id": "text-19",
      "x": 40,
      "y": 530,
      "width": 860,
      "height": 35,
      "text": "Deterministic scorers are the default because a gate you can't reproduce is a gate",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-20",
      "x": 40,
      "y": 562,
      "width": 860,
      "height": 35,
      "text": "you'll learn to ignore. Weighted, per-case bars mean one flaky case can't sink a good",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-21",
      "x": 40,
      "y": 594,
      "width": 860,
      "height": 35,
      "text": "change, and a red build points at the exact case and scorer that failed.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
  ],
